flowchart LR
    M["Input<br/>manifest or code"] --> A1
    subgraph G["LangGraph state graph: contract check after every stage"]
        A1["Agent 1<br/>Dependency Extraction<br/><i>dependency records</i>"] --> A2["Agent 2<br/>Evidence Collection<br/><i>evidence and registry status</i>"]
        A2 --> A3["Agent 3<br/>Risk Assessment<br/><i>one finding per label family</i>"]
        A3 --> A4["Agent 4<br/>Recommendation and Remediation<br/><i>action, target, cited claims</i>"]
        A4 --> A5["Agent 5<br/>Verification<br/><i>accept, reject or abstain</i>"]
    end
    A5 --> R["Output<br/>report with reasons"]
    LM["Language model<br/>local, no tools, no network"] --> A4
    D[("Recorded data, read only<br/>evidence store and registry recordings")] -.-> A2
    D -.-> A5
    classDef shaded fill:#e6e6e6,stroke:#000000,color:#000000
    classDef plain fill:#ffffff,stroke:#000000,color:#000000
    class A4,LM shaded
    class A1,A2,A3,D plain
    style A5 fill:#ffffff,stroke:#000000,stroke-width:3px,color:#000000
    style G fill:#ffffff,stroke:#000000,stroke-dasharray:5 4
